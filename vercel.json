{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "client",
      "framework": "create-react-app"
    },
    "server": {
      "root": "server",
      "framework": "express"
    }
  },
  "rewrites": [
    { "source": "/users(.*)", "destination": { "service": "server" } },
    { "source": "/movies(.*)", "destination": { "service": "server" } },
    { "source": "/cinemas(.*)", "destination": { "service": "server" } },
    { "source": "/showtimes(.*)", "destination": { "service": "server" } },
    { "source": "/reservations(.*)", "destination": { "service": "server" } },
    { "source": "/invitations(.*)", "destination": { "service": "server" } },
    { "source": "/uploads(.*)", "destination": { "service": "server" } },
    { "source": "/api/(.*)", "destination": { "service": "server" } },
    { "source": "/(.*)", "destination": { "service": "client" } }
  ]
}
