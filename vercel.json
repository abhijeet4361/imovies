{
  "version": 2,
  "buildCommand": "cd client && npm install && npm run build",
  "outputDirectory": "client/build",
  "installCommand": "npm install && cd server && npm install && cd ..",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "server/**"
    }
  },
  "rewrites": [
    { "source": "/users/:path*", "destination": "/api" },
    { "source": "/movies/:path*", "destination": "/api" },
    { "source": "/cinemas/:path*", "destination": "/api" },
    { "source": "/showtimes/:path*", "destination": "/api" },
    { "source": "/reservations/:path*", "destination": "/api" },
    { "source": "/invitations/:path*", "destination": "/api" },
    { "source": "/uploads/:path*", "destination": "/api" },
    { "source": "/((?!api|_next|static|favicon\\.ico).*)", "destination": "/index.html" }
  ]
}
